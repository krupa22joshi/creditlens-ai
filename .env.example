# Pick one: auto | mock | gemini | azure_openai | openai
# "auto" uses the first provider whose key is set, otherwise the offline mock writer.
LLM_PROVIDER=auto

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Policy retrieval: auto (dense embeddings when GEMINI_API_KEY is set, else lexical) | dense | hybrid | lexical
RETRIEVAL_MODE=auto

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI or any OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Training
CREDITLENS_TRAINING_ROWS=20000
CREDITLENS_CV_FOLDS=5
CREDITLENS_MAX_MEMO_ATTEMPTS=2
